# ============================================================
# DEAD MAN SWITCH — Production .gitignore
# ============================================================

# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing & Coverage
/coverage
*.lcov

# Next.js Build Outputs & Cache
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Production & Environment Variables
# Strict rule: ignore all .env files EXCEPT the example template
.env
.env.*
!.env.example

# Debug and Process Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vercel & Hosting Platform Metadata
.vercel

# IDEs & Developer Tools
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Cryptographic Keys & Private Certificates (Defense-in-Depth)
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Database Dumps & Local Backups
*.dump
*.backup
*.sql.bak
*.sqlite
*.db
supabase/.temp/
