# ============================================================
# DEAD MAN SWITCH — Required Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.
# ============================================================

# --- Supabase (Required) ---
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service role key — used ONLY in server-side scripts (never in browser).
# Found in: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Envelope Encryption (Required) ---
# Server-side AES-256-GCM key for encrypting key_material at rest.
# Format: <kid>:<64-hex-chars>
# Generate kid: openssl rand -hex 4
# Generate key: openssl rand -hex 32
APP_ENCRYPTION_KEY_PRIMARY=v1:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Keyring for key rotation — comma-separated list of additional keys.
# The primary key above is always tried first for decryption.
# APP_ENCRYPTION_KEYS=v2:<64-hex>,v3:<64-hex>

# --- OTP HMAC Signing (Required) ---
# Server-side HMAC-SHA256 key for signing one-time passwords.
# Format: <kid>:<64-hex-chars>
APP_OTP_SECRET_PRIMARY=otp1:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Email Delivery via Resend (Required for notifications) ---
# Get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From address (must be a verified domain in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- Application URL (Required for notification links) ---
# Used to generate claim links in email notifications.
# No trailing slash.
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# --- Cron Job Authentication (Required for dispatch endpoint) ---
# A strong random secret shared between the cron trigger and /api/notifications/dispatch.
# Generate: openssl rand -hex 32
CRON_SECRET=<strong-random-secret>
